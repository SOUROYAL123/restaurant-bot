{
  "name": "whatsapp-clinic-bot-production",
  "version": "3.0.0",
  "description": "Production WhatsApp multi-clinic bot with auto-approval, doctor workflow, and Google Sheets logging",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "dev": "nodemon bot.js",
    "test": "node test-connection.js",
