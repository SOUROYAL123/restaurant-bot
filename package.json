    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "razorpay": "^2.9.4",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
