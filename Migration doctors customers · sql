-- =====================================================
-- MIGRATION: Add Doctors & Enhanced Customer Tracking
-- Purpose: Separate doctor data + comprehensive customer database
-- Date: 2024-12-18
-- =====================================================

-- =====================================================
-- PART 1: CREATE DOCTORS TABLE
-- =====================================================

CREATE TABLE IF NOT EXISTS doctors (
    id SERIAL PRIMARY KEY,
    name VARCHAR(100) NOT NULL,
    whatsapp VARCHAR(20) NOT NULL UNIQUE, -- e.g., whatsapp:+919876543210
    email VARCHAR(100),
    specialization VARCHAR(100),
    qualification VARCHAR(200),
    clinic_id INTEGER REFERENCES clinics(id) ON DELETE CASCADE,
    status VARCHAR(20) DEFAULT 'active', -- active, inactive, on_leave
    joining_date DATE DEFAULT CURRENT_DATE,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- Index for fast lookups
CREATE INDEX idx_doctors_whatsapp ON doctors(whatsapp);
CREATE INDEX idx_doctors_clinic ON doctors(clinic_id);
CREATE INDEX idx_doctors_status ON doctors(status);

COMMENT ON TABLE doctors IS 'Stores doctor information with WhatsApp contact';
COMMENT ON COLUMN doctors.whatsapp IS 'WhatsApp number in Twilio format: whatsapp:+91XXXXXXXXXX';

-- =====================================================
-- PART 2: CREATE CUSTOMERS TABLE
-- =====================================================

CREATE TABLE IF NOT EXISTS customers (
    id SERIAL PRIMARY KEY,
    phone VARCHAR(20) NOT NULL UNIQUE, -- e.g., +919876543210 or whatsapp:+919876543210
    name VARCHAR(100) NOT NULL,
    email VARCHAR(100),
    preferred_language VARCHAR(5) DEFAULT 'en', -- en, bn, hi
    
    -- Demographics
    age INTEGER,
    gender VARCHAR(20), -- male, female, other, prefer_not_to_say
    location VARCHAR(200),
    
    -- Engagement tracking
    first_contact_date TIMESTAMP DEFAULT NOW(),
    last_contact_date TIMESTAMP DEFAULT NOW(),
    total_appointments INTEGER DEFAULT 0,
    total_cancelled INTEGER DEFAULT 0,
    total_completed INTEGER DEFAULT 0,
    
    -- Communication preferences
    notifications_enabled BOOLEAN DEFAULT true,
    reminder_preferences JSONB DEFAULT '{"24h": true, "1h": true}',
    
    -- Notes & metadata
    notes TEXT,
    tags VARCHAR(200)[], -- e.g., {'vip', 'regular', 'new'}
    
    status VARCHAR(20) DEFAULT 'active', -- active, inactive, blocked
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- Indexes for fast queries
CREATE INDEX idx_customers_phone ON customers(phone);
CREATE INDEX idx_customers_name ON customers(name);
CREATE INDEX idx_customers_status ON customers(status);
CREATE INDEX idx_customers_language ON customers(preferred_language);
CREATE INDEX idx_customers_last_contact ON customers(last_contact_date);

COMMENT ON TABLE customers IS 'Comprehensive customer database tracking all appointment seekers';
COMMENT ON COLUMN customers.phone IS 'Customer phone number (with or without whatsapp: prefix)';
COMMENT ON COLUMN customers.tags IS 'Array of tags for segmentation (e.g., VIP, regular, new)';

-- =====================================================
-- PART 3: UPDATE CLINICS TABLE
-- =====================================================

-- Add columns to existing clinics table if they don't exist
ALTER TABLE clinics 
ADD COLUMN IF NOT EXISTS primary_doctor_id INTEGER REFERENCES doctors(id),
ADD COLUMN IF NOT EXISTS total_appointments INTEGER DEFAULT 0,
ADD COLUMN IF NOT EXISTS total_customers INTEGER DEFAULT 0;

CREATE INDEX IF NOT EXISTS idx_clinics_primary_doctor ON clinics(primary_doctor_id);

COMMENT ON COLUMN clinics.primary_doctor_id IS 'Primary/default doctor for the clinic';

-- =====================================================
-- PART 4: UPDATE APPOINTMENTS TABLE
-- =====================================================

-- Add customer_id foreign key to appointments
ALTER TABLE appointments
ADD COLUMN IF NOT EXISTS customer_id INTEGER REFERENCES customers(id),
ADD COLUMN IF NOT EXISTS doctor_id INTEGER REFERENCES doctors(id),
ADD COLUMN IF NOT EXISTS appointment_notes TEXT,
ADD COLUMN IF NOT EXISTS reminder_sent BOOLEAN DEFAULT false,
ADD COLUMN IF NOT EXISTS feedback_rating INTEGER CHECK (feedback_rating BETWEEN 1 AND 5),
ADD COLUMN IF NOT EXISTS feedback_comment TEXT;

CREATE INDEX IF NOT EXISTS idx_appointments_customer ON appointments(customer_id);
CREATE INDEX IF NOT EXISTS idx_appointments_doctor ON appointments(doctor_id);
CREATE INDEX IF NOT EXISTS idx_appointments_reminder ON appointments(reminder_sent);

COMMENT ON COLUMN appointments.customer_id IS 'Links to customers table for detailed customer tracking';
COMMENT ON COLUMN appointments.doctor_id IS 'Assigned doctor for this appointment';

-- =====================================================
-- PART 5: CREATE CUSTOMER INTERACTIONS TABLE
-- =====================================================

-- Track all WhatsApp interactions with customers
CREATE TABLE IF NOT EXISTS customer_interactions (
    id SERIAL PRIMARY KEY,
    customer_id INTEGER REFERENCES customers(id) ON DELETE CASCADE,
    clinic_id INTEGER REFERENCES clinics(id),
    
    interaction_type VARCHAR(50) NOT NULL, -- booking_attempt, query, cancellation, feedback, complaint
    message_direction VARCHAR(20), -- inbound, outbound
    message_body TEXT,
    
    session_data JSONB, -- Store session state at time of interaction
    
    created_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX idx_interactions_customer ON customer_interactions(customer_id);
CREATE INDEX idx_interactions_clinic ON customer_interactions(clinic_id);
CREATE INDEX idx_interactions_type ON customer_interactions(interaction_type);
CREATE INDEX idx_interactions_date ON customer_interactions(created_at);

COMMENT ON TABLE customer_interactions IS 'Logs every interaction with customers for analytics and support';

-- =====================================================
-- PART 6: CREATE CUSTOMER PREFERENCES TABLE
-- =====================================================

CREATE TABLE IF NOT EXISTS customer_preferences (
    id SERIAL PRIMARY KEY,
    customer_id INTEGER REFERENCES customers(id) ON DELETE CASCADE UNIQUE,
    
    -- Appointment preferences
    preferred_time_slots VARCHAR(50)[], -- e.g., {'morning', 'evening'}
    preferred_days VARCHAR(20)[], -- e.g., {'monday', 'wednesday', 'friday'}
    preferred_clinic_id INTEGER REFERENCES clinics(id),
    preferred_doctor_id INTEGER REFERENCES doctors(id),
    
    -- Health information (optional)
    medical_conditions TEXT[],
    allergies TEXT[],
    current_medications TEXT[],
    
    -- Emergency contact
    emergency_contact_name VARCHAR(100),
    emergency_contact_phone VARCHAR(20),
    emergency_contact_relation VARCHAR(50),
    
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX idx_preferences_customer ON customer_preferences(customer_id);

COMMENT ON TABLE customer_preferences IS 'Stores customer preferences for personalized booking experience';

-- =====================================================
-- PART 7: CREATE TRIGGERS FOR AUTO-UPDATE
-- =====================================================

-- Trigger to update customers.total_appointments
CREATE OR REPLACE FUNCTION update_customer_stats()
RETURNS TRIGGER AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        UPDATE customers 
        SET 
            total_appointments = total_appointments + 1,
            last_contact_date = NOW()
        WHERE id = NEW.customer_id;
        
    ELSIF TG_OP = 'UPDATE' THEN
        IF NEW.status = 'confirmed' AND OLD.status != 'confirmed' THEN
            UPDATE customers 
            SET total_completed = total_completed + 1
            WHERE id = NEW.customer_id;
        ELSIF NEW.status = 'cancelled' AND OLD.status != 'cancelled' THEN
            UPDATE customers 
            SET total_cancelled = total_cancelled + 1
            WHERE id = NEW.customer_id;
        END IF;
    END IF;
    
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_update_customer_stats
AFTER INSERT OR UPDATE ON appointments
FOR EACH ROW
WHEN (NEW.customer_id IS NOT NULL)
EXECUTE FUNCTION update_customer_stats();

-- Trigger to update clinic stats
CREATE OR REPLACE FUNCTION update_clinic_stats()
RETURNS TRIGGER AS $$
BEGIN
    IF TG_OP = 'INSERT' THEN
        UPDATE clinics 
        SET total_appointments = total_appointments + 1
        WHERE id = NEW.clinic_id;
    END IF;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

CREATE TRIGGER trg_update_clinic_stats
AFTER INSERT ON appointments
FOR EACH ROW
EXECUTE FUNCTION update_clinic_stats();

