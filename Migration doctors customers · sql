-- View: Complete customer profile with appointment history
CREATE OR REPLACE VIEW customer_profiles AS
SELECT 
    c.id,
    c.name,
    c.phone,
    c.email,
    c.preferred_language,
    c.age,
    c.gender,
    c.location,
    c.first_contact_date,
    c.last_contact_date,
    c.total_appointments,
    c.total_cancelled,
    c.total_completed,
    c.status,
    cp.preferred_time_slots,
    cp.preferred_days,
    cl.name as preferred_clinic_name,
    d.name as preferred_doctor_name
FROM customers c
LEFT JOIN customer_preferences cp ON c.id = cp.customer_id
LEFT JOIN clinics cl ON cp.preferred_clinic_id = cl.id
LEFT JOIN doctors d ON cp.preferred_doctor_id = d.id;

-- View: Doctor performance dashboard
CREATE OR REPLACE VIEW doctor_performance AS
SELECT 
    d.id,
    d.name,
    d.whatsapp,
    d.specialization,
    cl.name as clinic_name,
    COUNT(a.id) as total_appointments,
    COUNT(CASE WHEN a.status = 'confirmed' THEN 1 END) as confirmed_appointments,
    COUNT(CASE WHEN a.status = 'cancelled' THEN 1 END) as cancelled_appointments,
    ROUND(AVG(a.feedback_rating), 2) as avg_rating
FROM doctors d
LEFT JOIN appointments a ON d.id = a.doctor_id
LEFT JOIN clinics cl ON d.clinic_id = cl.id
GROUP BY d.id, d.name, d.whatsapp, d.specialization, cl.name;

