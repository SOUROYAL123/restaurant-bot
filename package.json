{
  "name": "whatsapp-clinic-bot-production",
  "version": "3.0.0",
  "description": "Production WhatsApp multi-clinic bot with auto-approval, doctor workflow, Google Sheets logging, and comprehensive analytics",
  "main": "bot.js",
  "scripts": {
    "start": "node bot.js",
    "dev": "nodemon bot.js",
    "test": "node test-connection.js",
    "postinstall": "echo '✅ Dependencies installed successfully'",
    "prestart": "echo '🚀 Starting production server...'",
    "cron": "node jobs/autoApproveReject.js",
    "cron:reminders": "node cron-reminders.js",
    "cron:cleanup": "node jobs/cleanupSessions.js",
    "cron:queue": "node jobs/processMessageQueue.js",
    "setup": "node scripts/setupProduction.js",
    "setup:clinic": "node scripts/setupClinic.js",
    "status": "node scripts/checkStatus.js",
    "verify": "node scripts/verifySetup.js",
    "health": "node scripts/healthCheck.js",
    "analytics": "node scripts/analytics.js",
    "logs": "node scripts/viewLogs.js",
    "db:init": "node scripts/initNeonDB.js",
    "db:backup": "node scripts/backupNeonDB.js",
    "db:migrate": "node scripts/runMigration.js",
    "db:reset": "node scripts/resetDatabase.js",
    "db:seed": "node scripts/seedData.js",
    "doctor:test": "node test-doctor-notification.js",
    "doctor:diagnose": "node diagnose-notification-issue.js",
    "deploy": "npm run verify && npm run db:backup && echo '✅ Ready for deployment'",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "lint": "echo 'Running lint checks...'",
    "format": "echo 'Formatting code...'"
  },
  "keywords": [
    "whatsapp",
    "clinic",
    "multi-tenant",
    "twilio",
    "neon",
    "postgresql",
    "google-sheets",
    "appointment-booking",
    "auto-approval",
    "doctor-workflow",
    "healthcare",
    "chatbot",
    "serverless",
    "production-ready"
  ],
  "author": {
    "name": "Sourav Roy",
    "email": "sourav@legacylens.com",
    "url": "https://legacylens.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SOUROYAL123/clinis_database_bot-.git"
  },
  "bugs": {
    "url": "https://github.com/SOUROYAL123/clinis_database_bot-/issues",
    "email": "sourav@legacylens.com"
  },
  "homepage": "https://github.com/SOUROYAL123/clinis_database_bot-#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.3",
    "body-parser": "^1.20.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.2",
    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^4.1.5",
    "twilio": "^5.3.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "nodemonConfig": {
    "watch": [
      "bot.js",
      "handlers/",
      "utils/",
      "config/",
      "routes/",
      "jobs/",
      "middleware/"
    ],
    "ext": "js,json",
    "ignore": [
      "node_modules/",
      "backups/",
      "logs/",
      "*.log"
    ],
    "delay": "1000",
    "verbose": true
  },
  "config": {
    "port": "3000",
    "timezone": "Asia/Kolkata"
  }
}
