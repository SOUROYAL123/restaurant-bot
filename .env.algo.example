# ============================================================================
# enterprise_algo — environment template. Copy to .env and fill in.
# NEVER commit the real .env (it is git-ignored). Rotate any key that leaks.
# ============================================================================

# ---- Risk profile & mode ----
ALGO_PROFILE=default            # conservative | default | aggressive
ALGO_MODE=paper                 # backtest | paper | live
ALGO_DATA_PROVIDER=synthetic    # synthetic | csv | upstox | angelone
ALGO_BROKER=paper               # paper | upstox | angelone

# ---- Risk overrides (optional; blank = use profile defaults) ----
ALGO_CAPITAL=100000
ALGO_RISK_PER_TRADE=0.01
ALGO_MAX_POSITIONS=6
ALGO_MAX_POSITION_PCT=0.16
ALGO_MAX_SECTOR_PCT=0.35
ALGO_DAILY_LOSS_PCT=0.03
ALGO_DAILY_PROFIT_PCT=0.05
ALGO_MIN_CONFIDENCE=0.60
ALGO_SLIPPAGE_BPS=5
ALGO_PRODUCT=MIS                # MIS intraday | CNC delivery

# ---- LIVE TRADING SAFETY INTERLOCK ----
# Live orders require BOTH this flag AND the --i-understand-live-risk CLI flag.
ALGO_ALLOW_LIVE=false

# ---- Upstox (only needed for live/upstox data) ----
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_ACCESS_TOKEN=

# ---- Angel One SmartAPI (only needed for angelone data/broker) ----
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP=                     # TOTP secret (base32) or current 6-digit code
