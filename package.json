{
  "name": "whatsapp-clinic-bot-multilingual",
  "version": "2.0.0",
  "description": "Multi-clinic WhatsApp appointment booking bot with multilingual support and customer database (English, Bengali, Hindi)",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "nodemon src/bot.js",
    "init-db": "node scripts/initDatabase.js",
    "test": "node --version",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seedData.js"
  },
  "keywords": [
    "whatsapp",
    "twilio",
    "appointment",
    "clinic",
    "booking",
    "postgresql",
    "neon",
    "multilingual",
    "bengali",
    "hindi",
    "customer-database",
    "crm",
    "automation",
    "healthcare"
  ],
  "author": "Sourav Roy - Legacylens Automation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SOUROYAL123/clinis_database_bot-.git"
  },
  "dependencies": {
    "express": "^4.18.2",
    "twilio": "^4.20.0",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
