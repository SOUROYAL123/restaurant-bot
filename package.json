    "google-auth-library": "^9.15.1",
    "google-spreadsheet": "^4.1.5",
    "twilio": "^5.3.5",
    "body-parser": "^1.20.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": "18.x"
  },
  "repository": {
